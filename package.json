{
  "name": "wayfinder",
  "displayName": "Wayfinder",
  "description": "Shows where the open file sits in the codebase: what imports it, what it imports, its members, its tests and what is missing.",
  "version": "0.2.0",
  "publisher": "hermanyhho",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hermanyhho/wayfinder.git"
  },
  "icon": "media/icon.png",
  "keywords": [
    "imports",
    "dependencies",
    "map",
    "navigation",
    "ollama",
    "ai"
  ],
  "engines": {
    "vscode": "^1.116.0"
  },
  "categories": [
    "Visualization"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onWebviewPanel:wayfinder.map"
  ],
  "contributes": {
    "commands": [
      {
        "command": "wayfinder.showMap",
        "title": "Wayfinder: Show map for this file",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "wayfinder.showCallChain",
        "title": "Wayfinder: Show call chain"
      },
      {
        "command": "wayfinder.chooseAiModel",
        "title": "Wayfinder: Choose AI model"
      },
      {
        "command": "wayfinder.createAiRules",
        "title": "Wayfinder: Create AI rules file"
      },
      {
        "command": "wayfinder.returnToEditor",
        "title": "Wayfinder: Return to the editor from the map"
      },
      {
        "command": "wayfinder.toggleColumnFocus",
        "title": "Wayfinder: Focus one column, or show all three"
      },
      {
        "command": "wayfinder.nextColumn",
        "title": "Wayfinder: Move the next column to the centre"
      },
      {
        "command": "wayfinder.previousColumn",
        "title": "Wayfinder: Move the previous column to the centre"
      }
    ],
    "keybindings": [
      {
        "command": "wayfinder.showMap",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "activeWebviewPanelId != 'wayfinder.map'"
      },
      {
        "command": "wayfinder.returnToEditor",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "activeWebviewPanelId == 'wayfinder.map' && config.wayfinder.shortcut.returnToEditor"
      },
      {
        "command": "wayfinder.toggleColumnFocus",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "activeWebviewPanelId == 'wayfinder.map' && config.wayfinder.shortcut.columnFocus"
      },
      {
        "command": "wayfinder.nextColumn",
        "key": "alt+]",
        "when": "activeWebviewPanelId == 'wayfinder.map' && config.wayfinder.shortcut.columnFocus"
      },
      {
        "command": "wayfinder.previousColumn",
        "key": "alt+[",
        "when": "activeWebviewPanelId == 'wayfinder.map' && config.wayfinder.shortcut.columnFocus"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "wayfinder.showMap",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "wayfinder.showCallChain",
          "when": "editorLangId =~ /^(typescript|javascript)(react)?$/",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "wayfinder.showCallChain",
          "when": "editorLangId =~ /^(typescript|javascript)(react)?$/"
        },
        {
          "command": "wayfinder.returnToEditor",
          "when": "activeWebviewPanelId == 'wayfinder.map'"
        },
        {
          "command": "wayfinder.toggleColumnFocus",
          "when": "activeWebviewPanelId == 'wayfinder.map'"
        },
        {
          "command": "wayfinder.nextColumn",
          "when": "activeWebviewPanelId == 'wayfinder.map'"
        },
        {
          "command": "wayfinder.previousColumn",
          "when": "activeWebviewPanelId == 'wayfinder.map'"
        }
      ]
    },
    "configuration": [
      {
        "title": "AI: Instructions",
        "order": 1,
        "properties": {
          "wayfinder.ai.instructions": {
            "type": "string",
            "default": "",
            "editPresentation": "multilineText",
            "markdownDescription": "**Your rules for Scan with AI.** Type them in the box below, one rule per line. Wayfinder adds them to every scan. Only you get these rules.\n\nExamples:\n- `Flag every function longer than 40 lines.`\n- `Flag any use of the any type.`\n- `Point out functions with no error handling around network calls.`\n\nTo share rules with your team, put them in `.wayfinder/rules.md` and commit it. [Create or open the rules file](command:wayfinder.createAiRules)\n\nWayfinder adds the team rules first, then yours, after its built-in rules. Together they are cut at 2,000 characters."
          }
        }
      },
      {
        "title": "AI: Model",
        "order": 2,
        "properties": {
          "wayfinder.ai.model": {
            "type": "string",
            "default": "",
            "markdownDescription": "Model for Scan with AI. [Choose a model](command:wayfinder.chooseAiModel)\n\nOr type an Ollama model such as `qwen2.5-coder:1.5b`, or `claude-code` or `codex` to scan through that CLI in the cloud. Leave empty to turn AI off.",
            "order": 1
          },
          "wayfinder.ai.baseUrl": {
            "type": "string",
            "default": "http://localhost:11434",
            "description": "Where Ollama runs.",
            "order": 2
          }
        }
      },
      {
        "title": "AI: Behaviour",
        "order": 3,
        "properties": {
          "wayfinder.ai.scope": {
            "type": "string",
            "enum": [
              "file",
              "neighbours"
            ],
            "enumDescriptions": [
              "Send only the open file.",
              "Also send the code of the open file's direct imports, callers and tests, cut to fit the model."
            ],
            "default": "file",
            "description": "What Scan with AI sends to the model."
          }
        }
      },
      {
        "title": "Shortcut",
        "order": 4,
        "properties": {
          "wayfinder.shortcut.focusMap": {
            "type": "boolean",
            "default": true,
            "description": "Opening or showing the map moves keyboard focus to the current file card. Turn off to keep focus in the editor."
          },
          "wayfinder.shortcut.returnToEditor": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Pressing the **Wayfinder: Show map for this file** shortcut while the map has focus moves focus back to the open file's editor, at the same cursor position."
          },
          "wayfinder.shortcut.columnFocus": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "While the map has focus, Cmd+Alt+Enter (Ctrl+Alt+Enter) turns focus mode on or off, and Alt+] and Alt+[ move the next or previous column to the centre. Turn off to free these keys. The focus icon in a column header still works."
          }
        }
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "vscode:prepublish": "npm run typecheck && node esbuild.mjs --production",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@types/vscode": "^1.116.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "vitest": "^4.1.11"
  }
}
