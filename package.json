{
  "name": "wayfinder",
  "displayName": "Wayfinder",
  "description": "Shows where the open file sits in the codebase: what imports it, what it imports, its tests and what is missing.",
  "version": "0.1.0",
  "publisher": "hermanho",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.116.0"
  },
  "categories": [
    "Visualization"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "wayfinder.showMap",
        "title": "Wayfinder: Show map for this file",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "wayfinder.chooseAiModel",
        "title": "Wayfinder: Choose AI model"
      },
      {
        "command": "wayfinder.createAiRules",
        "title": "Wayfinder: Create AI rules file"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "wayfinder.showMap",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Wayfinder",
      "properties": {
        "wayfinder.ai.baseUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Where Ollama runs."
        },
        "wayfinder.ai.model": {
          "type": "string",
          "default": "",
          "description": "Model for Scan with AI: an Ollama model such as qwen2.5-coder:1.5b, or claude-code or codex to scan through that CLI in the cloud. Leave empty to turn AI off."
        },
        "wayfinder.ai.instructions": {
          "type": "string",
          "default": "",
          "editPresentation": "multilineText",
          "description": "Your own rules for Scan with AI. Added after the built-in rules and the team rules in .wayfinder/rules.md."
        },
        "wayfinder.ai.scope": {
          "type": "string",
          "enum": ["file", "neighbours"],
          "enumDescriptions": ["Send only the open file.", "Also send the code of the open file's direct imports, callers and tests, cut to fit the model."],
          "default": "file",
          "description": "What Scan with AI sends to the model."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "vscode:prepublish": "npm run typecheck && node esbuild.mjs --production",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@types/vscode": "^1.116.0",
    "esbuild": "^0.28.2",
    "vitest": "^4.1.11"
  }
}
