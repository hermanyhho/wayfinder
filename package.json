{
  "name": "mapmycode",
  "displayName": "MapMyCode",
  "description": "Visualize and understand any codebase instantly with AI-powered dependency graphs, file summaries, and codebase Q&A.",
  "version": "1.0.0",
  "license": "MIT",

  "icon": "public/mapmycode.png",

  "repository": {
    "type": "git",
    "url": "https://github.com/bitHead22/MapMyCode"
  },

  "engines": {
    "vscode": "^1.116.0"
  },

  "categories": [
    "AI",
    "Visualization"
  ],

  "keywords": [
    "ai",
    "code graph",
    "dependency graph",
    "code visualization",
    "codebase analysis",
    "developer tools"
  ],

  "main": "./out/extension.js",

  "activationEvents": [],

  "contributes": {
    "commands": [
      {
        "command": "mapmycode.open",
        "title": "MapMyCode: Open Panel",
        "icon": "$(graph)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mapmycode",
          "title": "MapMyCode",
          "icon": "public/assets/icon.svg"
        }
      ]
    },
    "views": {
      "mapmycode": [
        {
          "type": "webview",
          "id": "mapmycode.mainView",
          "name": "MapMyCode"
        }
      ]
    }
  },

  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },

  "devDependencies": {
    "@types/node": "^20.19.39",
    "@types/vscode": "^1.116.0",
    "typescript": "^5.9.3"
  }
}